PORT=3001
NODE_ENV=development

# Supabase — mismas keys que sucrexpress-next
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_KEY=tu_service_key_aqui

# JWT — mismo secret que sucrexpress-next
JWT_SECRET=tu_jwt_secret_aqui
JWT_EXPIRES_IN=24h

# CORS — permite peticiones desde el frontend Next.js
FRONTEND_URL=http://localhost:3000

# Google APIs
GOOGLE_ROUTES_API_KEY=tu_google_routes_api_key
GOOGLE_MAPS_API_KEY=tu_google_maps_key
